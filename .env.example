# Copy this file to .env for local development. Never commit .env.
# Every external endpoint and credential belongs to the operator.

# Presentation and optional handoff links
BRAND_NAME=Home Services
MCP_SERVER_NAME=Home Services MCP
MCP_SERVER_DESCRIPTION=Search, review, and request home services through an operator-configured MCP server.
APP_LINK=
SITE_BASE_URL=
UI_BASE_URL=
SUPPORT_URL=
LANDING_REDIRECT_URL=
ALLOWED_ORIGINS=http://localhost:8000

# Operator-owned service APIs (leave a capability unset to disable it)
PROVIDERS_API=
COORDS_RESOLVE_API=
ZIP_RESOLVE_API=
GEOCODING_API=
GEOCODING_API_KEY=
BOOKING_API=
SERVICE_REQUESTS_URL=
REVIEWS_API=
SERVICE_REQUESTS_METADATA_URL=
SEND_BOOK_NOTIFICATION_API=
SEND_JOB_TO_SLACK_API=

# Optional persistence and monitoring integrations
MCP_MONITOR_ENABLED=false
MCP_MONITOR_SLACK_CHANNEL=mcp-monitor
MCP_MONITOR_SLACK_API=

# Optional operator-owned identity/profile integrations
PROFILE_LOOKUP_API=
PROFILE_LOOKUP_METHOD=POST
AUTH_WEBHOOK_URL=
HOMEOWNER_PROFILE_API=
AUTH_PHONE_ALIASES={}

# Optional upstream MCP relay. Disabled when UPSTREAM_MCP_URL is empty.
# The relay uses only UPSTREAM_MCP_AUTH_TOKEN; inbound user Authorization is
# never forwarded automatically.
UPSTREAM_MCP_URL=
UPSTREAM_MCP_AUTH_TOKEN=
UPSTREAM_MCP_TIMEOUT_SECONDS=15

# OAuth and optional compatibility authentication
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_TTL=604800
PUBLIC_BASE_URL=http://localhost:8000
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/callback
OAUTH_DYNAMIC_CLIENT_REGISTRATION_ENABLED=false
MVP_STATIC_MCP_TOKEN=
OPENAI_APPS_CHALLENGE_TOKEN=
AUTH_STATE_TABLE_NAME=
REQUIRE_DURABLE_STATE=false
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_KEY_MAX_LENGTH=128

# Limits
SEARCH_PROVIDERS_FETCH_COUNT=10
SEARCH_PROVIDERS_RETURN_COUNT=6
RATE_LIMIT_RPM=60
USER_RATE_LIMIT_RPM=120
TOOL_RATE_LIMIT_RPM=30
LOCATION_RESOLVE_RATE_LIMIT_RPM=15
BOOKING_RATE_LIMIT_RPM=10
